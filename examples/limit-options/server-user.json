{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-in",
      "listen": "127.0.0.1",
      "listen_port": 24511,
      "users": [
        {
          "name": "alice",
          "uuid": "9b65b7e1-04c8-4717-8f45-2aa61fd25937"
        },
        {
          "name": "bob",
          "uuid": "c5f34436-2db1-4c9a-abbb-8f048cb2a7ef"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "localhost",
        "alpn": [
          "h2"
        ],
        "certificate_path": "examples/xhttp/cert.pem",
        "key_path": "examples/xhttp/key.pem"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "auth_user": [
          "alice"
        ],
        "action": "limit-options",
        "scope": "user",
        "clients": 1,
        "total_mbps": 8,
        "sampling_period": "1s",
        "total_burst_mbps": 10
      },
      {
        "auth_user": [
          "bob"
        ],
        "action": "limit-options",
        "scope": "user",
        "clients": 2,
        "total_mbps": 20,
        "sampling_period": "1s",
        "total_burst_mbps": 24
      }
    ],
    "final": "direct"
  }
}
